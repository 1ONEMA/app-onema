# ONEMA SAÚDE — variáveis de ambiente (exemplo SEM segredos). Copie para .env e ajuste.
# Ambiente: development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Origem pública do app (usada no QR do certificado e na checagem de Origin/CSRF)
PUBLIC_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787

# Banco SQLite e armazenamento privado de mídia (fora de pastas públicas; incluir no backup)
DATABASE_PATH=./data/onema.sqlite
MEDIA_DIR=./data/media

# Segredos — OBRIGATÓRIOS em produção (>= 32 caracteres aleatórios). Nunca versionar.
APP_SECRET=
PAYMENT_WEBHOOK_SECRET=

SESSION_TTL_HOURS=12
# MFA (TOTP) obrigatório para perfis administrativos. Manter true fora do desenvolvimento local.
REQUIRE_ADMIN_MFA=true

# Pagamentos: somente SANDBOX é suportado nesta entrega (gateway real não autorizado — P-009)
PAYMENT_PROVIDER=SANDBOX
# Taxa Academy: matrícula exige pedido PAGO (política a confirmar — P-009)
ACADEMY_REQUIRE_PAYMENT=true
# WhatsApp permanece desligado até integração oficial validada
WHATSAPP_ENABLED=false
# Validade provisória do convite ao responsável (não definida na fonte)
SHARE_INVITE_TTL_DAYS=7

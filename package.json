{
  "name": "onema-saude-app",
  "version": "0.1.0",
  "private": true,
  "description": "ONEMA SAÚDE — PWA (ONEMA Academy e ONEMA PRIME) — ambiente de homologação",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env server/src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env server/src/db/cli.ts seed",
    "db:seed:demo": "tsx --env-file-if-exists=.env server/src/db/cli.ts seed-demo",
    "db:backup": "tsx --env-file-if-exists=.env server/src/db/cli.ts backup",
    "user:create": "tsx --env-file-if-exists=.env server/src/db/cli.ts create-user",
    "jobs:billing": "tsx --env-file-if-exists=.env server/src/db/cli.ts billing",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "netlify:init": "tsx --disable-warning=ExperimentalWarning server/src/db/netlify-init.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@netlify/blobs": "^11.1.1",
    "@netlify/neon": "^0.1.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@netlify/functions": "^6.0.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "hash-wasm": "^4.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
